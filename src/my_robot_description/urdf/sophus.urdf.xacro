<?xml version="1.0"?>
<robot name="sophus" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="wheel_x" value="0.85"/>
    <xacro:property name="wheel_y" value="-0.22"/>
    <xacro:property name="wheel_z" value="-0.26"/>
    <xacro:property name="wheel_caster" value="-0.26"/>
    <xacro:property name="motor_rotation" value="1.57"/>
    <xacro:property name="wheel_rotation" value="-3.14"/>

    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/base_plate_v1.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 3.14 0"/>
            <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/base_plate_v1.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.15"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>


    <xacro:macro name="wheel_assembly" params="side reflect">
        <link name="stepper_motor_${side}">
            <visual>
                <geometry>
                    <mesh filename="package://my_robot_description/meshes/nema17_17HS4401_b.stl" scale="9 9 9"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="grey"><color rgba="0.4 0.4 0.4 1"/></material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://my_robot_description/meshes/nema17_17HS4401_b.stl" scale="9 9 9"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.15"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            </inertial>
        </link>

        <link name="wheel_${side}">
            <visual>
                <geometry>
                    <mesh filename="package://my_robot_description/meshes/wheel_v1.stl" scale="0.01 0.01 0.01"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://my_robot_description/meshes/wheel_v1.stl" scale="0.01 0.01 0.01"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.1"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            </inertial>
        </link>

        <joint name="motor_joint_${side}" type="fixed">
            <parent link="base_link"/>
            <child link="stepper_motor_${side}"/>
            <origin xyz="${reflect*wheel_x} ${wheel_y} ${wheel_z}" rpy="0 ${reflect*motor_rotation} 0"/>
            <axis xyz="0 0 0"/>
        </joint>

        <joint name="wheel_joint_${side}" type="continuous">
            <parent link="stepper_motor_${side}"/>
            <child link="wheel_${side}"/>
            <origin xyz="0 0 0.26" rpy="0 ${reflect*wheel_rotation} 0"/>
            <axis xyz="0 0 1"/>
        </joint>
    </xacro:macro>

    <link name="caster_wheel">
        <visual>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/Caster_Wheel_V2.stl" scale="8.5 8.5 8.5"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/Caster_Wheel_V2.stl" scale="8.5 8.5 8.5"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.15"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="0 1.02 -0.22" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>


    <xacro:wheel_assembly side="left"  reflect="-1"/>
    <xacro:wheel_assembly side="right" reflect="1"/>

</robot>