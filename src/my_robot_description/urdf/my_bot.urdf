<?xml version='1.0'?>

<robot name="my_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- STEP 1 - Robot footprint -->
  <link name="base_footprint"></link>

  <link name='base_link'>
    <pose>0 0 0.1 0 0 0</pose>
    <inertial>
        <mass value="10.0"/>
        <origin xyz="0.0 0 0" rpy=" 0 0 0"/>
        <inertia
          ixx="0.04167" ixy="0" ixz="0"
          iyy="0.08333" iyz="0"
          izz="0.10833"
        />
    </inertial>

    <collision name='collision'>
        <origin xyz="0 0 0" rpy=" 0 0 0"/>
        <geometry>
        <box size=".3 .2 .1"/>
        </geometry>
    </collision>

    <visual name='base_link_visual'>
        <origin xyz="0 0 0" rpy=" 0 0 0"/>
        <geometry>
        <box size=".3 .2 .1"/>
      </geometry>
    </visual>

  </link>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0.07 0" rpy="0 0 0" />
    <parent link="base_footprint"/>
    <child link="base_link" />
  </joint>

  <link name='left_wheel'>
    <inertial>
      <mass value= "0.2"/>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707" />
      <inertia ixx="0.00026" ixy="0" ixz="0" iyy="0.00026" iyz="0" izz="0.00049"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder radius=".07" length=".03"/>
      </geometry>
    </collision>
    <visual name="left_wheel_visual">
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder radius=".07" length=".03"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="-0.06 0.12 0" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="left_wheel" />
    <axis xyz="0 1 0" rpy="0 0 0"/>
    <limit effort="100" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name='right_wheel'>
    <inertial>
      <mass value= "0.2"/>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707" />
      <inertia ixx="0.00026" ixy="0" ixz="0" iyy="0.00026" iyz="0" izz="0.00049"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder radius=".07" length=".03"/>
      </geometry>
    </collision>
    <visual name="right_wheel_visual">
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder radius=".07" length=".03"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>
  
  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="-0.06 -0.12 0" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="right_wheel" />
    <axis xyz="0 1 0" rpy="0 0 0"/>
    <limit effort="100" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name='caster_wheel'>
    <inertial>
      <mass value= "0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.000147" ixy="0" ixz="0" iyy="0.000147" iyz="0" izz="0.000147"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
    </collision>
    <visual name="right_wheel_visual">
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <origin xyz="0.02 0 -0.035" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="caster_wheel" />
    <axis xyz="0 0 0" rpy="0 0 0"/>
    <dynamics damping="0.10" friction="0.10"/>
  </joint>

  <!-- STEP 4 - RViz colors -->
  <xacro:include filename="$(find my_robot_description)/urdf/materials.xacro" />
</robot>