<?xml version="1.0"?>
<robot name="sophus" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Included AFTER sophus_core.xacro, so wheel_radius / wheel_half_track are visible here -->

    <xacro:property name="wheel_separation" value="${2*wheel_half_track}"/>   <!-- 2.14 m (was 2*1 = 2) -->
    <xacro:property name="max_wheel_torque" value="20"/>
    <xacro:property name="max_wheel_accel" value="2.0"/>

    <!-- Friction: grippy wheels, slippery caster -->
    <gazebo reference="wheel_left">
        <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="wheel_right">
        <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="caster_wheel">
        <mu1>0.0</mu1><mu2>0.0</mu2>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>wheel_joint_left</left_joint>
            <right_joint>wheel_joint_right</right_joint>

            <wheel_separation>${wheel_separation}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>

            <max_wheel_torque>${max_wheel_torque}</max_wheel_torque>
            <max_wheel_acceleration>${max_wheel_accel}</max_wheel_acceleration>

            <topic>cmd_vel</topic>

            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <odom_publisher_frequency>50</odom_publisher_frequency>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
        </plugin>
    </gazebo>
</robot>