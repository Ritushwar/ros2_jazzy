<?xml version="1.0"?>
<robot name="sophus">
    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/base_plate_v1.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/base_plate_v1.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.15"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <link name="stepper_motor">
        <visual>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/nema17_17HS4401_b.stl" scale="9 9 9"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"><color rgba="0.4 0.4 0.4 1"/></material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/nema17_17HS4401_b.stl" scale="9 9 9"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.15"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <link name="wheel">
        <visual>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/wheel_v1.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/wheel_v1.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="motor_joint_right" type="fixed">
        <parent link="base_link"/>
        <child link="stepper_motor"/>
        <origin xyz="0.85 -0.22 0.26" rpy="0 1.57 0"/>
        <axis xyz="0 0 0"/>
    </joint>

    <joint name="wheel_joint_right" type="continuous">
        <parent link="stepper_motor"/>
        <child link="wheel"/>
        <origin xyz="0 0 0.26" rpy="0 -3.14 0"/>
        <axis xyz="0 0 1"/>
    </joint>

</robot>